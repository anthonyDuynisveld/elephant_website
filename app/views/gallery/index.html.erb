<%= render "shared/page_header",
      title: "Elephant Photos",
      intro: "Look at pictures of elephants in the wild. Tap or click a photo to see it bigger and find out what's happening." %>

<div class="gallery-grid">
  <% @photos.each do |photo| %>
    <%= link_to gallery_path(photo), class: "gallery-item" do %>
      <%= render "shared/image_placeholder" %>
      <div class="caption">
        <h3><%= photo.title %></h3>
        <p><%= photo.caption %></p>
      </div>
    <% end %>
  <% end %>
</div>

<div id="submit" class="submit-section">
  <h3>Have you seen an elephant?</h3>
  <p>
    Maybe you saw one at a zoo, a wildlife park or on a trip. Soon, a grown-up will be able to send us your
    elephant photos to show here. Check back later!
  </p>
</div>
