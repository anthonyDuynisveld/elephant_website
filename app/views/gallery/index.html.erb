<%= render "shared/page_header",
      title: "Elephant Photos",
      intro: "Look at pictures of elephants in the wild. Tap or click a photo to see it bigger and find out what's happening." %>

<div class="gallery-grid">
  <% @photos.each do |photo| %>
    <%= link_to gallery_path(photo), class: "gallery-item",
          data: { mascot_fact: photo.description,
                  controller: "hover-video",
                  action: "mouseenter->hover-video#play mouseleave->hover-video#reset focusin->hover-video#play focusout->hover-video#reset" } do %>
      <% if photo.video_path %>
        <%= video_tag photo.video_path, poster: photo.poster_path, muted: true, loop: true, playsinline: true,
              preload: "metadata", class: "gallery-video", data: { hover_video_target: "video" } %>
      <% elsif photo.poster_path %>
        <div class="gallery-media">
          <%= image_tag photo.poster_path, alt: photo.title, loading: "lazy", class: "gallery-video", style: photo.tile_image_style %>
        </div>
      <% else %>
        <%= render "shared/image_placeholder" %>
      <% end %>
      <div class="caption">
        <h3><%= photo.title %></h3>
        <p><%= photo.caption %></p>
      </div>
    <% end %>
  <% end %>
</div>
