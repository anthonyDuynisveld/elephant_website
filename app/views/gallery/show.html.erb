<% content_for :title, @photo.title %>

<%= link_to "← Back to gallery", gallery_index_path, class: "text-link" %>

<figure class="photo-block">
  <%= render "shared/image_placeholder" %>
  <figcaption><%= @photo.caption %></figcaption>
</figure>

<div class="section">
  <h1 class="page-title"><%= @photo.title %></h1>
  <p class="page-subtitle"><%= @photo.description %></p>
</div>

<div class="highlight-box">
  <p><strong>Got a great elephant photo?</strong> <%= link_to "Share it with us", gallery_index_path(anchor: "submit"), class: "text-link" %>.</p>
</div>

<nav class="pager">
  <div>
    <% if @previous_photo %>
      <%= link_to "← #{@previous_photo.title}", gallery_path(@previous_photo), class: "text-link" %>
    <% end %>
  </div>
  <div>
    <% if @next_photo %>
      <%= link_to "#{@next_photo.title} →", gallery_path(@next_photo), class: "text-link" %>
    <% end %>
  </div>
</nav>
