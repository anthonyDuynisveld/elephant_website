<%# Ellie the mascot. Positioned and animated by mascot_controller.js; hovering any
    element with a data-mascot-fact attribute shows that fact in her speech bubble. %>
<div class="mascot" data-mascot-target="mascot">
  <div class="mascot__bubble" data-mascot-target="bubble" role="status" aria-live="polite" aria-hidden="true">
    <span class="mascot__label" data-mascot-target="label"></span>
    <p class="mascot__text" data-mascot-target="text"></p>
  </div>

  <svg class="mascot__body" viewBox="0 0 100 100" width="88" height="88" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <!-- body and feet -->
    <ellipse cx="50" cy="78" rx="26" ry="18" fill="#9aa0a6"/>
    <rect x="30" y="82" width="12" height="15" rx="5" fill="#7d838a"/>
    <rect x="58" y="82" width="12" height="15" rx="5" fill="#7d838a"/>
    <path d="M33 95h6M61 95h6" stroke="#fdf6e3" stroke-width="2" stroke-linecap="round"/>
    <!-- ears (flap while talking) -->
    <g class="mascot__ear mascot__ear--left">
      <ellipse cx="22" cy="40" rx="18" ry="22" fill="#868c93"/>
      <ellipse cx="24" cy="41" rx="11" ry="15" fill="#e8b4b8"/>
    </g>
    <g class="mascot__ear mascot__ear--right">
      <ellipse cx="78" cy="40" rx="18" ry="22" fill="#868c93"/>
      <ellipse cx="76" cy="41" rx="11" ry="15" fill="#e8b4b8"/>
    </g>
    <!-- head and tusks -->
    <circle cx="50" cy="40" r="22" fill="#9aa0a6"/>
    <path d="M41 55 C38 60 39 64 42 66" fill="none" stroke="#fdf6e3" stroke-width="3" stroke-linecap="round"/>
    <path d="M59 55 C62 60 61 64 58 66" fill="none" stroke="#fdf6e3" stroke-width="3" stroke-linecap="round"/>
    <!-- trunk (outlined so it stands out against the body; waves while talking) -->
    <g class="mascot__trunk">
      <path d="M50 48 C50 62 48 70 56 74 C61 76 64 72 61 69" fill="none" stroke="#868c93" stroke-width="11" stroke-linecap="round"/>
      <path d="M50 48 C50 62 48 70 56 74 C61 76 64 72 61 69" fill="none" stroke="#9aa0a6" stroke-width="8" stroke-linecap="round"/>
    </g>
    <!-- eyes and cheeks -->
    <circle cx="42" cy="36" r="3" fill="#1a1a1a"/>
    <circle cx="58" cy="36" r="3" fill="#1a1a1a"/>
    <circle cx="43" cy="35" r="1" fill="#fff"/>
    <circle cx="59" cy="35" r="1" fill="#fff"/>
    <circle cx="35" cy="46" r="3" fill="#e8b4b8" opacity="0.7"/>
    <circle cx="65" cy="46" r="3" fill="#e8b4b8" opacity="0.7"/>
  </svg>
</div>
