<%# Savanna behind the site title: a sun and clouds in the sky, and hills along the
    bottom whose front edge is the nav's green, so the nav reads as the ground. A
    mother and calf walk across, the calf holding her tail, drawn in Ellie's colours
    (see _mascot.html.erb). Purely decorative; positioned in application.tailwind.css. %>
<div class="header-scene" aria-hidden="true">
  <svg width="0" height="0" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- elephant facing right, feet on y=88; trunk and tusks are added per animal -->
      <g id="scene-elephant">
        <path d="M14 40 C8 46 8 54 6 60" fill="none" stroke="#868c93" stroke-width="3" stroke-linecap="round"/>
        <ellipse cx="6" cy="62" rx="2.6" ry="3.6" fill="#6f757b"/>
        <rect x="22" y="52" width="12" height="36" rx="5" fill="#868c93"/>
        <rect x="64" y="52" width="12" height="36" rx="5" fill="#868c93"/>
        <ellipse cx="50" cy="44" rx="38" ry="26" fill="#9aa0a6"/>
        <rect x="31" y="56" width="13" height="32" rx="5" fill="#9aa0a6"/>
        <rect x="73" y="56" width="13" height="32" rx="5" fill="#9aa0a6"/>
        <circle cx="92" cy="34" r="18" fill="#9aa0a6"/>
        <ellipse cx="82" cy="38" rx="12" ry="16" fill="#868c93"/>
        <ellipse cx="83" cy="39" rx="7.5" ry="11" fill="#e8b4b8"/>
        <circle cx="99" cy="30" r="2.4" fill="#1a1a1a"/>
        <circle cx="99.8" cy="29.2" r="0.8" fill="#fff"/>
        <circle cx="101" cy="39" r="3" fill="#e8b4b8" opacity="0.7"/>
      </g>

      <!-- flat-topped acacia, base on y=88 -->
      <g id="scene-acacia">
        <path d="M70 88 C71 74 68 62 58 48" fill="none" stroke="#6d4c41" stroke-width="6" stroke-linecap="round"/>
        <path d="M69 70 C75 60 82 52 92 44" fill="none" stroke="#6d4c41" stroke-width="4" stroke-linecap="round"/>
        <path d="M62 54 C56 50 48 47 40 44" fill="none" stroke="#6d4c41" stroke-width="3" stroke-linecap="round"/>
        <ellipse cx="70" cy="38" rx="62" ry="10" fill="#4f8a2b"/>
        <ellipse cx="46" cy="32" rx="32" ry="9" fill="#5e9c35"/>
        <ellipse cx="94" cy="31" rx="34" ry="9" fill="#5e9c35"/>
        <ellipse cx="70" cy="27" rx="30" ry="7" fill="#6fae3f"/>
      </g>

      <g id="scene-cloud" fill="#fff">
        <circle cx="24" cy="24" r="13"/>
        <circle cx="42" cy="17" r="16"/>
        <circle cx="60" cy="25" r="12"/>
        <rect x="10" y="24" width="62" height="13" rx="6.5"/>
