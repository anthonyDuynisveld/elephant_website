  <svg class="header-scene__cloud header-scene__cloud--two" viewBox="0 0 80 40" xmlns="http://www.w3.org/2000/svg"><use href="#scene-cloud"/></svg>

  <svg class="header-scene__hills" viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
