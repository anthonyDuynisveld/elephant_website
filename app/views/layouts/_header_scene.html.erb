  </svg>

  <svg class="header-scene__tree" viewBox="0 0 140 90" xmlns="http://www.w3.org/2000/svg"><use href="#scene-acacia"/></svg>
  <svg class="header-scene__tree header-scene__tree--small" viewBox="0 0 140 90" xmlns="http://www.w3.org/2000/svg"><use href="#scene-acacia"/></svg>

  <svg class="header-scene__herd" viewBox="0 0 196 90" xmlns="http://www.w3.org/2000/svg">
