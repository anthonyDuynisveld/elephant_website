      <path d="M105 40C113 52 110 70 117 78" fill="none" stroke="#868c93" stroke-width="12" stroke-linecap="round"/>
      <path d="M105 40C113 52 110 70 117 78" fill="none" stroke="#9aa0a6" stroke-width="9" stroke-linecap="round"/>
      <path d="M101 48C104 55 109 57 113 55" fill="none" stroke="#fdf6e3" stroke-width="3.5" stroke-linecap="round"/>
    </g>
  </svg>

  <svg class="header-scene__ground" viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0 104C240 96 480 96 720 100C960 104 1200 96 1440 100V120H0Z" fill="#2e7d32"/>
  </svg>
</div>
