  <svg class="header-scene__sun" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
    <path d="M72 40H78M62.6 62.6L66.9 66.9M40 72V78M17.4 62.6L13.1 66.9M8 40H2M17.4 17.4L13.1 13.1M40 8V2M62.6 17.4L66.9 13.1"
