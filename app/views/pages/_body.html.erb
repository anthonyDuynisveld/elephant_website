        <path d="M-45,185 Q-55,210 -48,235" stroke="#7a9a68" stroke-width="5" fill="none" stroke-linecap="round"/>
        <!-- Tusks -->
        <line x1="-38" y1="188" x2="-42" y2="208" stroke="#f5f0e0" stroke-width="3" stroke-linecap="round"/>
        <!-- Legs -->
        <rect x="-25" y="225" width="12" height="53" rx="4" fill="#7a9a68"/>
        <rect x="-8" y="225" width="12" height="53" rx="4" fill="#7a9a68"/>
        <rect x="10" y="225" width="12" height="53" rx="4" fill="#8fac7a"/>
        <rect x="27" y="225" width="12" height="53" rx="4" fill="#8fac7a"/>
