      <!-- African Savanna Elephant (4m = 224px) -->
      <g transform="translate(680, 0)">
        <ellipse cx="0" cy="135" rx="65" ry="52" fill="#6b8f5e"/>
        <ellipse cx="-45" cy="105" rx="26" ry="32" fill="#6b8f5e"/>
        <!-- Ears -->
        <ellipse cx="-68" cy="98" rx="16" ry="24" fill="#5a7d4e"/>
