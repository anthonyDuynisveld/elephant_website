        <!-- Ears -->
        <ellipse cx="-56" cy="140" rx="10" ry="16" fill="#b5956a"/>
        <!-- Trunk -->
        <path d="M-53,160 Q-65,195 -55,230" stroke="#b5956a" stroke-width="6" fill="none" stroke-linecap="round"/>
        <!-- Tusks -->
        <line x1="-46" y1="165" x2="-50" y2="190" stroke="#f5f0e0" stroke-width="3" stroke-linecap="round"/>
        <!-- Legs -->
        <rect x="-30" y="207" width="14" height="71" rx="5" fill="#b5956a"/>
