        <rect x="-25" y="202" width="20" height="16" rx="3" fill="#b8d8e8"/>
        <rect x="5" y="202" width="20" height="16" rx="3" fill="#b8d8e8"/>
        <rect x="-40" y="236" width="80" height="30" rx="4" fill="#5e8ea8"/>
        <circle cx="-22" cy="272" r="10" fill="#444"/>
        <circle cx="-22" cy="272" r="5" fill="#888"/>
        <circle cx="22" cy="272" r="10" fill="#444"/>
        <circle cx="22" cy="272" r="5" fill="#888"/>
        <text x="0" y="296" font-size="11" fill="#666" text-anchor="middle" font-weight="600">Car</text>
        <text x="0" y="310" font-size="10" fill="#999" text-anchor="middle">1.5 m</text>
      </g>

      <!-- African Forest Elephant (2.5m = 140px) -->
      <g transform="translate(330, 0)">
        <ellipse cx="0" cy="195" rx="45" ry="35" fill="#8fac7a"/>
        <ellipse cx="-30" cy="175" rx="20" ry="22" fill="#8fac7a"/>
        <!-- Ears -->
        <ellipse cx="-48" cy="168" rx="12" ry="18" fill="#7a9a68"/>
