      <!-- Ground line -->
      <line x1="20" y1="280" x2="780" y2="280" stroke="#b5a88a" stroke-width="2"/>

      <!-- Scale markers on left -->
      <text x="12" y="280" font-size="11" fill="#888" text-anchor="end">0 m</text>
      <line x1="18" y1="280" x2="24" y2="280" stroke="#ccc" stroke-width="1"/>
      <text x="12" y="224" font-size="11" fill="#888" text-anchor="end">1 m</text>
      <line x1="18" y1="224" x2="780" y2="224" stroke="#e8e4dc" stroke-width="1" stroke-dasharray="4,4"/>
      <text x="12" y="168" font-size="11" fill="#888" text-anchor="end">2 m</text>
      <line x1="18" y1="168" x2="780" y2="168" stroke="#e8e4dc" stroke-width="1" stroke-dasharray="4,4"/>
      <text x="12" y="112" font-size="11" fill="#888" text-anchor="end">3 m</text>
      <line x1="18" y1="112" x2="780" y2="112" stroke="#e8e4dc" stroke-width="1" stroke-dasharray="4,4"/>
      <text x="12" y="56" font-size="11" fill="#888" text-anchor="end">4 m</text>
      <line x1="18" y1="56" x2="780" y2="56" stroke="#e8e4dc" stroke-width="1" stroke-dasharray="4,4"/>

      <!-- Person (1.8m = 101px) -->
      <g transform="translate(70, 0)">
        <!-- Head -->
        <circle cx="0" cy="170" r="9" fill="#d4a574"/>
        <!-- Body -->
        <line x1="0" y1="179" x2="0" y2="230" stroke="#d4a574" stroke-width="4"/>
        <!-- Arms -->
        <line x1="0" y1="190" x2="-12" y2="215" stroke="#d4a574" stroke-width="3"/>
        <line x1="0" y1="190" x2="12" y2="215" stroke="#d4a574" stroke-width="3"/>
        <!-- Legs -->
        <line x1="0" y1="230" x2="-8" y2="278" stroke="#d4a574" stroke-width="3"/>
        <line x1="0" y1="230" x2="8" y2="278" stroke="#d4a574" stroke-width="3"/>
        <text x="0" y="296" font-size="11" fill="#666" text-anchor="middle" font-weight="600">Person</text>
        <text x="0" y="310" font-size="10" fill="#999" text-anchor="middle">1.8 m</text>
      </g>

      <!-- Car (1.5m tall = 84px) -->
      <g transform="translate(170, 0)">
