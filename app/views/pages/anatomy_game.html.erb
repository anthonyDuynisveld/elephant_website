<%= render "shared/page_header",
      title: "Elephant Anatomy Game",
      intro: "How well do you know an elephant's body? Find the parts to win stars!" %>

<%# Each part: id => [name, fun fact]. The facts match the Bodies & Food page. %>
<% parts = {
  "trunk"    => ["Trunk", "An elephant's trunk is its nose and upper lip joined together. It has around 40,000 muscles and can suck up about 8 litres of water."],
  "ear"      => ["Ear", "Elephants flap their big ears to cool down. The thin skin is full of blood vessels that give off heat."],
  "tusk"     => ["Tusk", "A tusk is really a very long front tooth. It keeps growing for an elephant's whole life."],
  "eye"      => ["Eye", "Elephants have long eyelashes that help keep dust out of their eyes."],
  "leg"      => ["Leg", "Elephant legs are straight like pillars, to hold up all that weight. Under each foot is a squishy cushion of fat."],
  "toenails" => ["Toenails", "Elephants have up to five toenails on each foot. How many depends on the kind of elephant."],
  "tail"     => ["Tail", "An elephant's tail has a tuft of thick hair at the end. It works like a fly swatter."],
  "body"     => ["Body", "An elephant's skin can be about 2.5 centimetres thick. Its wrinkles hold water and mud, which help it stay cool."]
} %>
<%# Attributes every clickable part shares %>
<% part_attrs = ->(id) {
  { class: "game-part", role: "button", tabindex: 0, aria: { label: parts[id][0] },
    data: { part: id, name: parts[id][0], fact: parts[id][1], anatomy_game_target: "part",
            action: "click->anatomy-game#guess keydown->anatomy-game#guess" } }
} %>

<div class="section game" data-controller="anatomy-game">
  <div class="game-start" data-anatomy-game-target="start">
    <p>You will get <strong>8 questions</strong>. Each one names a part of the elephant. Tap that part on the picture!</p>
    <button type="button" class="button game-button" data-action="anatomy-game#start">Start the game 🎮</button>
  </div>

  <div class="game-board" data-anatomy-game-target="board" hidden>
    <div class="game-status">
      <span data-anatomy-game-target="progress"></span>
      <span class="game-score" data-anatomy-game-target="score" aria-live="polite"></span>
    </div>
    <h2 class="game-prompt" data-anatomy-game-target="prompt" aria-live="polite"></h2>
  </div>

  <%# The picture is always visible, so you can look at it before you start. %>
  <svg class="game-elephant" viewBox="0 0 600 400" role="group" aria-label="A grey elephant. Choose a part of its body.">
    <ellipse cx="300" cy="372" rx="260" ry="14" fill="#c8e6c9"/>

    <%= tag.g(**part_attrs.("leg")) do %>
      <rect x="250" y="240" width="52" height="120" rx="22" fill="#7d8a93"/>
      <rect x="378" y="240" width="52" height="120" rx="22" fill="#7d8a93"/>
      <rect x="215" y="240" width="56" height="125" rx="24" fill="#90a4ae"/>
      <rect x="425" y="240" width="56" height="125" rx="24" fill="#90a4ae"/>
    <% end %>

    <%= tag.g(**part_attrs.("toenails")) do %>
      <% [226, 240, 254, 436, 450, 464].each do |x| %>
        <ellipse cx="<%= x %>" cy="355" rx="7" ry="9" fill="#fff3e0" stroke="#8d6e63" stroke-width="2"/>
      <% end %>
    <% end %>

    <%= tag.g(**part_attrs.("tail")) do %>
      <path d="M492 160 C525 190 530 235 522 270" fill="none" stroke="#90a4ae" stroke-width="12" stroke-linecap="round"/>
      <path d="M522 262 C508 285 512 305 522 312 C534 305 538 285 522 262 Z" fill="#455a64"/>
    <% end %>

    <%# The head is part of the body for clicking %>
    <%= tag.g(**part_attrs.("body")) do %>
      <path d="M210 150 C240 80 420 70 480 120 C515 150 510 230 470 260 C400 285 280 285 215 255 Z" fill="#90a4ae"/>
      <circle cx="190" cy="175" r="82" fill="#90a4ae"/>
    <% end %>

    <%= tag.g(**part_attrs.("trunk")) do %>
      <path d="M135 200 C95 235 85 295 100 335 C106 352 132 350 134 332" fill="none" stroke="#90a4ae" stroke-width="42" stroke-linecap="round"/>
      <path d="M135 200 C95 235 85 295 100 335 C106 352 132 350 134 332" fill="none" stroke="#78909c" stroke-width="2" stroke-dasharray="4 10" stroke-linecap="round"/>
    <% end %>

    <%= tag.g(**part_attrs.("tusk")) do %>
      <path d="M160 222 C150 255 128 275 98 280" fill="none" stroke="#8d6e63" stroke-width="18" stroke-linecap="round"/>
      <path d="M160 222 C150 255 128 275 98 280" fill="none" stroke="#fffde7" stroke-width="12" stroke-linecap="round"/>
    <% end %>

    <%= tag.g(**part_attrs.("ear")) do %>
      <path d="M215 100 C290 90 310 170 270 230 C250 255 215 250 200 215 C190 175 190 120 215 100 Z" fill="#b0bec5" stroke="#78909c" stroke-width="3"/>
      <path d="M222 125 C268 120 280 175 255 215 C243 232 225 228 218 208 C212 180 212 145 222 125 Z" fill="#f8bbd0" opacity="0.7"/>
    <% end %>

    <%= tag.g(**part_attrs.("eye")) do %>
      <circle cx="163" cy="150" r="20" fill="transparent"/>
      <circle cx="163" cy="150" r="8" fill="#1a1a1a"/>
      <circle cx="165" cy="147" r="2.5" fill="#fff"/>
      <path d="M154 140 l-5 -6 M162 137 l-2 -8 M171 139 l3 -7" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round"/>
    <% end %>
  </svg>

  <div class="game-message" aria-live="polite">
    <p class="game-feedback" data-anatomy-game-target="feedback"></p>
    <p class="game-fact" data-anatomy-game-target="fact"></p>
  </div>
  <button type="button" class="button game-button" data-anatomy-game-target="next" data-action="anatomy-game#next" hidden>Next question ➜</button>

  <div class="game-summary highlight-box" data-anatomy-game-target="summary" hidden>
    <h2>Game over!</h2>
    <p data-anatomy-game-target="result"></p>
    <button type="button" class="button game-button" data-action="anatomy-game#start">Play again 🔄</button>
  </div>
</div>

<div class="section">
  <p>Want to learn more first? Visit <%= link_to "Bodies & Food", body_and_food_path, class: "text-link" %>, then come back and play!</p>
</div>
