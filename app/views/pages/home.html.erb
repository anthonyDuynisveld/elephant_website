<div class="hero-image">
  <%= render "shared/image_placeholder", label: "Elephant photo coming soon" %>
</div>

<div class="section">
  <h1 class="page-title">Welcome</h1>
  <p class="page-subtitle">
    This site is all about elephants, the largest land animals on Earth. Learn where they live, how they're
    classified, what they eat, how their bodies work and how they behave. Then browse the gallery and share your own photos.
  </p>
</div>

<div class="section">
  <span class="section-label">Explore</span>
  <div class="card-grid">
    <% [
      ["Habitat", habitat_path, "Where on Earth elephants live and what they need to thrive."],
      ["Classification", classification_path, "Scientific names, species and subspecies."],
      ["Image Gallery", gallery_index_path, "Photos of elephants, plus a place to submit your own."],
      ["Diet", diet_path, "What elephants eat, how often, and how much."],
      ["Anatomy & Biology", anatomy_path, "Trunks, tusks, size, lifespan and how elephants breathe."],
      ["Behavior", behavior_path, "Finding food, staying safe from predators and sleeping."]
    ].each do |title, path, blurb| %>
      <div class="card">
        <h3><%= title %></h3>
        <p><%= blurb %></p>
        <%= link_to "Learn more →", path, class: "card-link" %>
      </div>
    <% end %>
  </div>
</div>

<div class="section">
  <span class="section-label">Quick facts</span>
  <div class="stat-row">
    <div class="stat-card">
      <div class="stat-label">Weight</div>
      <div class="stat-value">6,000 kg</div>
      <p>Weight of an adult African savanna bull elephant.</p>
    </div>
    <div class="stat-card">
      <div class="stat-label">Lifespan</div>
      <div class="stat-value">60–70 years</div>
      <p>Typical lifespan in the wild.</p>
    </div>
    <div class="stat-card">
      <div class="stat-label">Trunk</div>
      <div class="stat-value">~40,000</div>
      <p>Muscle bundles in an elephant's trunk.</p>
    </div>
  </div>
</div>
