<%# This is the home page, so it opens with the welcome (and photo) for school-project visitors %>
<div class="hero-image">
  <%= image_tag "pages/home-hero.jpg", alt: "An African elephant dust-bathing, shown from trunk to tail", class: "hero-photo" %>
</div>

<%= render "shared/page_header",
      title: "Hi, elephant explorer!",
      intro: "Are you doing a school project about elephants? You're in the right place! Here you'll find facts and pictures " \
             "to help you make a great poster, presentation or report." %>

<div class="section kids" data-controller="tabs">
  <span class="section-label">Famous elephants</span>
  <h2>Elephants in Pop Culture</h2>
  <p>
    Elephants are stars! You can find them in books, cartoons, movies and nature shows. Meet some famous elephants,
    then find out what real elephants can do. Pick a tab to meet the elephants inside!
  </p>

  <div class="kid-tabs" role="tablist" aria-label="Kinds of famous elephants">
    <% PopCultureReference.categories.each_with_index do |category, index| %>
      <button type="button" role="tab" class="kid-tab" id="pop-culture-<%= category.key %>-tab"
              aria-controls="pop-culture-<%= category.key %>" aria-selected="<%= index.zero? %>" tabindex="<%= index.zero? ? 0 : -1 %>"
              data-tabs-target="tab" data-action="tabs#select keydown->tabs#navigate">
        <span class="kid-tab__picture" aria-hidden="true"><%= category.picture %></span>
        <span><%= category.label %></span>
        <span class="kid-tab__count"><%= PopCultureReference.for(category).size %></span>
      </button>
    <% end %>
  </div>

  <% PopCultureReference.categories.each_with_index do |category, index| %>
    <% references = PopCultureReference.for(category) %>
    <div class="kid-tab-panel" role="tabpanel" id="pop-culture-<%= category.key %>" aria-labelledby="pop-culture-<%= category.key %>-tab"
         tabindex="0" data-tabs-target="panel" data-controller="load-more" data-load-more-per-page-value="3" <%= "hidden" unless index.zero? %>>
      <h2><%= category.title %></h2>
      <p><%= category.intro %></p>

      <div class="kid-grid">
        <% references.each_with_index do |reference, reference_index| %>
          <%= render "pages/pop_culture_card", reference:, category:, hidden: reference_index >= 3 %>
        <% end %>
      </div>

      <% if references.size > 3 %>
        <div class="load-more">
          <button type="button" class="kid-link" data-load-more-target="button" data-action="load-more#more">
            Show more <%= category.picture %>
          </button>
        </div>
      <% end %>

      <% if category.footnote %>
        <div class="highlight-box">
          <p><%= sanitize(category.footnote) %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="section kids">
  <span class="section-label">Did you know?</span>
  <div class="highlight-box">
    <p>
      <strong>Jumbo size!</strong> Long ago, there was a real elephant named Jumbo. He was so big and so famous
      that people started saying "jumbo" to mean "really big". So a jumbo jet is named after an elephant!
    </p>
    <%= copy_button "Jumbo size!" %>
  </div>
</div>

<div class="section kids">
  <span class="section-label">Your turn</span>
  <div class="kid-card kid-card--sun kid-card--wide">
    <div class="kid-picture" role="img" aria-label="Crayons and paper">🖍️📄</div>
    <h3>Make your own elephant!</h3>
    <p>
      Grab some paper and crayons. Draw your very own elephant character. What is its name? What colour is it?
      Does it have a special power, like flying or super hearing?
    </p>
    <%= link_to "See real elephant photos for ideas →", what_they_do_path, class: "kid-link" %>
  </div>
</div>

<div class="section">
  <span class="section-label">Keep exploring</span>
  <div class="card-grid">
    <% [
      ["🐘", "Bodies & Food", body_and_food_path, "Trunks, tusks, giant ears, and a LOT of plants to eat!"],
      ["🌍", "Life in the Wild", life_in_the_wild_path, "Where elephants live, and what they get up to all day."],
      ["🌳", "Family Tree", classification_path, "Meet the three kinds of elephants and their cousins, the mammoths."]
    ].each do |icon, title, path, blurb| %>
      <div class="card">
        <div class="card-icon" aria-hidden="true"><%= icon %></div>
        <h3><%= title %></h3>
        <p><%= blurb %></p>
        <%= link_to "Let's go →", path, class: "card-link", aria: { label: "Let's go to #{title}" } %>
      </div>
    <% end %>
  </div>

  <div class="highlight-box">
    <p>
      <strong>Project tip:</strong> Pick one topic. Write down 3 facts you like. Then explain them in your own words,
      and add a picture to show what you mean.
    </p>
    <%= copy_button "Project tip" %>
  </div>
</div>
